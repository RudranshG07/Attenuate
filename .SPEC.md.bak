## 2. Data model

```solidity
struct Grant {
    uint256 capabilities;        // bitmask, see CapabilityRegistry
    uint256 spendCap;            // wei ceiling for this node's subtree
    uint256 queryBudget;         // x402 units
    uint256 remaining;           // unallocated portion of spendCap
    uint64  expiry;              // unix seconds
    uint16  maxDepth;            // further delegation hops allowed
    bool    readOnly;
    bytes32 parent;              // namehash
    uint64  parentEpochAtGrant;
    uint64  epoch;
}

mapping(bytes32 => Grant) public grants;   // namehash => Grant
bytes32 public constant ROOT = bytes32(0);
```

### CapabilityRegistry

Bit index → semantic meaning. Keep it small; 8 bits is enough for the demo.

| Bit | Capability | Target constraint |
|---|---|---|
| 0 | `swap.uniswap` | Uniswap router only |
| 1 | `lend.aave.supply` | Aave pool only |
| 2 | `lend.aave.repay` | Aave pool only |
| 3 | `lend.aave.withdraw` | Aave pool only |
| 4 | `erc20.approve` | allowlisted tokens |
| 5 | `transfer.native` | — |
| 6 | `data.graph.read` | no onchain target |
| 7 | `delegate` | may call `register()` |

```solidity
mapping(uint8 => address) public allowedTarget;   // capBit => contract
mapping(uint8 => bytes4)  public allowedSelector; // capBit => function
```

---

## 3. The attenuation invariant — core of the project

```solidity
function _assertAttenuated(Grant memory p, Grant memory c) internal pure {
    require(c.capabilities & p.capabilities == c.capabilities, "SCOPE_WIDENED");
    require(c.spendCap    <= p.remaining,   "CAP_EXCEEDS_UNALLOCATED");
    require(c.queryBudget <= p.queryBudget, "BUDGET_WIDENED");
    require(c.expiry      <= p.expiry,      "EXPIRY_EXTENDED");
    require(c.maxDepth     < p.maxDepth,    "DEPTH_EXCEEDED");
    require(!p.readOnly || c.readOnly,      "READONLY_ESCALATION");
}
```

`c & p == c` is the subset test. Any bit the child sets that the parent lacks is dropped by the AND, equality fails, revert.

**`p.remaining`, not `p.spendCap`.** Otherwise a parent holding 100 grants 100 to each of two children.

### Fuzz test (must pass before anything else)

```solidity
function testFuzz_ChildNeverExceedsParent(Grant memory p, Grant memory c) public {
    vm.assume(_isWellFormed(p) && _isWellFormed(c));
    try this.exposed_assertAttenuated(p, c) {
        assertEq(c.capabilities & p.capabilities, c.capabilities);
        assertLe(c.spendCap, p.remaining);
        assertLe(c.expiry, p.expiry);
        assertLt(c.maxDepth, p.maxDepth);
        if (p.readOnly) assertTrue(c.readOnly);
    } catch {}
}
```

---

## 4. AttenuatedSubregistry

```solidity
function register(
    bytes32 parentNode,
    string calldata label,
    address owner,
    Grant calldata childGrant
) external returns (bytes32 childNode) {
    Grant storage p = grants[parentNode];

    require(_hasRole(msg.sender, parentNode, ROLE_GRANT), "NOT_GRANTOR");
    require(isLive(parentNode), "PARENT_DEAD");
    _assertAttenuated(p, childGrant);

    p.remaining -= childGrant.spendCap;          // allocate

    childNode = keccak256(abi.encodePacked(parentNode, keccak256(bytes(label))));
    require(grants[childNode].epoch == 0, "EXISTS");

    grants[childNode] = childGrant;
    grants[childNode].remaining          = childGrant.spendCap;
    grants[childNode].parent             = parentNode;
    grants[childNode].parentEpochAtGrant = p.epoch;
    grants[childNode].epoch              = 1;

    _mintSubname(parentNode, label, owner);      // [UNVERIFIED] ENSv2 registry call
    _writeGrantToResolver(childNode, childGrant); // [UNVERIFIED] PermissionedResolver

    emit Granted(parentNode, childNode, label, owner, childGrant);
}
```

**Requirement:** an over-privileged child must be unmintable. Not rejected later — never created.

---

## 5. Epoch revocation — O(1) subtree kill

```solidity
function revoke(bytes32 node) external {
    require(_hasRole(msg.sender, node, ROLE_REVOKE), "NOT_REVOKER");
    Grant storage g = grants[node];
    g.epoch++;                                   // single SSTORE
    grants[g.parent].remaining += g.remaining;   // unspent returns to parent
    emit Revoked(node, g.epoch);
}

function isLive(bytes32 node) public view returns (bool) {
    bytes32 cur = node;
    for (uint256 i = 0; i < MAX_WALK; i++) {
        if (cur == ROOT) return true;
        Grant storage g = grants[cur];
        if (g.epoch == 0) return false;
        if (g.expiry < block.timestamp) return false;
        if (g.parentEpochAtGrant != grants[g.parent].epoch) return false;
        cur = g.parent;
    }
    revert("DEPTH_OVERFLOW");
}
```

Bumping a parent's epoch invalidates every descendant in the same block, at any depth. `MAX_WALK` = 8; real depth is capped by `maxDepth` at 3–4.

**Test:** grant a 3-level chain, revoke the root, assert every descendant returns `isLive == false` in the same block, and assert `revoke` gas is constant regardless of subtree size.

---

## 6. Executor — use-time enforcement

ENS resolvers **store** records; they do not intercept transactions. Two enforcement points:

| Point | Contract | Stops |
|---|---|---|
| Grant time | `AttenuatedSubregistry.register()` | An over-privileged name existing |
| Use time | `Executor.execute()` | An action outside the resolved Grant |

```solidity
function execute(
    bytes32 node,
    uint8   capBit,
    address target,
    uint256 value,
    bytes calldata data
) external returns (bytes memory) {
    Grant storage g = grants[node];

    require(msg.sender == _resolveAddr(node), "NOT_AGENT");   // [UNVERIFIED] ENS addr
    require(isLive(node), "REVOKED_OR_EXPIRED");
    require(g.capabilities & (1 << capBit) != 0, "CAP_MISSING");
    require(!g.readOnly || value == 0, "READONLY");
    require(value <= g.remaining, "OVER_BUDGET");
    require(target == capReg.allowedTarget(capBit), "TARGET_MISMATCH");
    require(bytes4(data) == capReg.allowedSelector(capBit), "SELECTOR_MISMATCH");

    g.remaining -= value;
    (bool ok, bytes memory ret) = target.call{value: value}(data);
    require(ok, "CALL_FAILED");
    emit Executed(node, capBit, target, value);
    return ret;
}
```

