{
  "name": "attenuate",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "forge build --root contracts",
    "test": "forge test --root contracts",
    "test:keyring": "tsx --test keyring-remote/*.test.ts",
    "test:gas": "forge test --root contracts --gas-report",
    "test:numbers": "forge test --root contracts --match-contract GasTest -vv",
    "test:invariant": "forge test --root contracts --match-contract ConservationTest -vv",
    "test:escalation": "forge test --root contracts --match-contract EscalationTest -vvv",
    "web": "next dev web -p 3000",
    "web:build": "next build web",
    "chain": "anvil",
    "chain:fork": "bash -lc 'set -a; [ -f .env ] && . ./.env; set +a; anvil --fork-url \"${SEPOLIA_RPC_URL:-https://ethereum-sepolia.publicnode.com}\" --port 8545'",
    "deploy:local": "tsx scripts/deploy-local.ts",
    "deploy:fork": "tsx scripts/deploy-fork.ts",
    "deploy:forge": "forge script --root contracts script/Deploy.s.sol:Deploy --rpc-url http://127.0.0.1:8545 --broadcast",
    "smoke": "tsx scripts/smoke.ts",
    "plan": "tsx scripts/plan.ts",
    "agent": "tsx scripts/agent.ts",
    "smoke:fork": "DEPLOYMENT=fork tsx scripts/smoke.ts",
    "swap:fork": "DEPLOYMENT=fork tsx scripts/swap-fork.ts",
    "speculos": "./scripts/speculos.sh",
    "speculos:approve": "tsx scripts/speculos-approve.ts",
    "subgraph:codegen": "cd subgraph && graph codegen",
    "subgraph:build": "cd subgraph && graph build",
    "subgraph:deploy": "cd subgraph && graph auth \"$GRAPH_STUDIO_API_KEY\" && graph deploy ${SUBGRAPH_SLUG:-atte}"
  },
  "packageManager": "npm@10.9.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@ledgerhq/wallet-cli": "^2.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@substreams/core": "^0.17.0",
    "@substreams/manifest": "^0.16.0",
    "next": "^15.5.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "viem": "^2.21.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@graphprotocol/graph-cli": "^0.98.1",
    "@graphprotocol/graph-ts": "^0.38.2",
    "@ledgerhq/device-management-kit": "^1.9.0",
    "@ledgerhq/device-signer-kit-ethereum": "^1.18.0",
    "@ledgerhq/device-transport-kit-speculos": "^1.2.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}